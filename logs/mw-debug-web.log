[rdbms] MediaWiki\Storage\SqlBlobStore::storeBlob [0.032ms] localhost: INSERT INTO "text" (old_text,old_flags) VALUES ('= Workshop: Research Data and Knowledge Orders (TP1) =
''''''Dates:'''''' September 4–5, 2025  
''''''Location:'''''' Philipps University Marburg, Pilgrimstein XX, Research Center Deutscher Sprachatlas Room: X  

== Thursday, September 4, 2025 ==

{| class="wikitable"
! Time !! Activity
|-
| 12:30 PM || Arrival, Registration
|-
| 1:00 PM || Welcome │ Peter Bell and Melanie Ulz
|-
| 1:15–2:00 PM || Input 1 │ Olaf Simons – Critical Perspectives on Knowledge Orders and Research Data (25 min)
Discussion
|-
| 2:00–2:45 PM || Input 2 │ Aline Deicke (Marburg) – Data Architecture and the Development of Virtual Research Environments (25 min)
Discussion
|-
| 2:45–3:15 PM || Coffee Break
|-
| 3:15–4:00 PM || Input 3 │ Erik Stein – Critical Analysis of Antiziganist and Ambivalent Content (25 min)
Discussion
|-
| 4:00–4:45 PM || Presentation of the Research Environment │ Peter Bell and Mohammad Fazleh Elahi (25 min)
Discussion
|-
| 4:45–5:15 PM || Initial Assessments, Open Questions, Ideas for Further Development │ N.N. Respondent (Peter to ask?)
|-
| 7:00 PM || Joint Dinner (optional, informal) at “Spanish Restaurant am Theater” or Italien Restaurant (Please reserve!)
|}

== Friday, September 5, 2025 ==

{| class="wikitable"
! Time !! Activity
|-
| 9:00–11:30 AM || Working Session │ Discussion and Constitution of the Virtual Research Environment by all Project Participants
|-
| 11:30 AM–12:00 PM || Summary │ Next Steps and Task Distribution
|-
| 12:00–1:00 PM || Lunch Break │ University Cafeteria (Lahnberge)
|-
| 1:00–3:00 PM || Networking Session for Doctoral Candidates and Postdocs: Using the Research Environment for Individual Projects
|-
| 3:00 PM || End of Workshop
|}','utf-8')
